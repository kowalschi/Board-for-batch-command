        private void CreateCommandLineText() // creaza command.line.txt
        {

            //string fileName = @"D:\\AWtoolDATA\\command_line.txt";
            string fileName = @"" + caleAbsData + caleAbsDataJson + "\\command_line.txt";

            try
            {
                // Check if file already exists. If yes, delete it.     
                if (File.Exists(fileName))
                {
                    File.Delete(fileName);
                }

                // Create a new file     
                using (StreamWriter sw = File.CreateText(fileName))
                {
                    //sw.WriteLine("New file created: {0}", DateTime.Now.ToString());
                    //sw.WriteLine("Author: Mahesh Chand");
                    //sw.WriteLine("Add one more line ");
                    //sw.WriteLine("Add one more line ");
